{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billnest-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "PLAID_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "billnest-db",
      "database_id": "2caa6111-47ea-4179-9c66-c2a813c6999d"
    }
  ]
}
