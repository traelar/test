{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billnest-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "vars": {
    "PLAID_ENV": "sandbox"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "billnest-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "secrets": {
    "required": [
      "PLAID_CLIENT_ID",
      "PLAID_SECRET",
      "BILLNEST_API_KEY",
      "TOKEN_ENCRYPTION_KEY"
    ]
  }
}
