;}
  }
  function navigateFuelStation(i){const st=state.fuelSnapshot?.stations?.[Number(i)];if(!st)return;openExternal(`geo:${st.lat||0},${st.lng||0}?q=${encodeURIComponent(st.address||st.name)}`);}

  const ATTACH_DB='clear_choice_attachments_v1', ATTACH_STORE='files';
  function attachmentDb(){return new Promise((resolve,reject)=>{const req=indexedDB.open(ATTACH_DB,1);req.onupgradeneeded=()=>{if(!req.result.objectStoreNames.contains(ATTACH_STORE))req.result.createObjectStore(ATTACH_STORE,{keyPath:'id'});};req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);});}
  async function putAttachment(rec){const db=await attachmentDb();return new Promise((resolve,reject)=>{const tx=db.transaction(ATTACH_STORE,'readwrite');tx.objectStore(ATTACH_STORE).put(rec);tx.oncomplete=()=>{db.close();resolve();};tx.onerror=()=>{db.close();reject(tx.error);};});}
  async function getAttachment(id){const db=await attachmentDb();return new Promise((resolve,reject)=>{const tx=db.transaction(ATTACH_STORE,'readonly');const req=tx.objectStore(ATTACH_STORE).get(id);req.onsuccess=()=>resolve(req.result||null);req.onerror=()=>reject(req.error);tx.oncomplete=()=>db.close();});}
  let workTimerInterval=null;

  function consentLabel(status) {
    return status === 'opted_in' ? 'Opted In' : status === 'opted_out' ? 'Opted Out' : 'Not Asked';
  }

  function nextDateFromFrequency(iso, frequency) {
    const d = parseDate(iso);
    if (!d) return null;
    if (frequency === 'weekly') d.setDate(d.getDate()+7);
    else if (frequency === 'biweekly') d.setDate(d.getDate()+14);
    else if (frequency === 'four_weeks') d.setDate(d.getDate()+28);
    else if (frequency === 'monthly') d.setMonth(d.getMonth()+1);
    else return null;
    return isoFromDate(d);
  }

  function frequencyLabel(value) {
    return ({weekly:'Weekly',biweekly:'Every 2 Weeks',four_weeks:'Every 4 Weeks',monthly:'Monthly',one_time:'One-Time',custom:'Custom'})[value] || 'Custom';
  }

  function renderTemplate(type, customer, appointment) {
    const raw = state.settings.templates[type] || '';
    return raw
      .replaceAll('{first_name}', customer?.firstName || 'there')
      .replaceAll('{date}', appointment?.date ? formatDate(appointment.date, {short:true}) : 'your scheduled date')
      .replaceAll('{time}', appointment?.time ? formatTime(appointment.time) : 'your scheduled time')
      .replaceAll('{business_name}', state.settings.businessName || 'our cleaning business');
  }

  function getUpcomingAppointment(customerId, fromDate = todayISO()) {
    return state.appointments
      .filter(a => a.customerId === customerId && a.status !== 'cancelled' && a.date >= fromDate)
      .sort((a,b) => `${a.date}T${a.time}`.localeCompare(`${b.date}T${b.time}`))[0] || null;
  }

  function showView(name) {
    $$('.view').forEach(v => v.classList.toggle('active', v.id === `view-${name}`));
    $$('.nav-item').forEach(b => b.classList.toggle('active', b.dataset.view === name));
    closeDrawer();
    if (name === 'schedule') renderSchedule();
    if (name === 'texts') renderTextCenter();
    if (name === 'earnings') renderEarnings();
  }

  function openDrawer() { $('#sidebar').classList.add('open'); $('#drawerScrim').classList.add('show'); }
  function closeDrawer() { $('#sidebar').classList.remove('open'); $('#drawerScrim').classList.remove('show'); }

  function renderHeader() {
    const d = new Date();
    $('#todayLabel').textContent = new Intl.DateTimeFormat('en-US',{weekday:'long',month:'long',day:'numeric'}).format(d);
    const hour = d.getHours();
    const greeting = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';
    $('#greeting').textContent = state.settings.ownerName ? `${greeting}, ${state.settings.ownerName}` : `${greeting}`;
  }

  function renderDashboard() {
    const today = todayISO();
    const todayApps = state.appointments.filter(a => a.date === today && a.status !== 'cancelled').sort((a,b)=>a.time.localeCompare(b.time));
    const start = parseDate(today); start.setDate(start.getDate() - start.getDay());
    const end = new Date(start); end.setDate(end.getDate()+6);
    const weekApps = state.appointments.filter(a => {
      const d = parseDate(a.date); return d >= start && d <= end && a.status !== 'cancelled';
    });
    const unpaid = state.appointments.filter(a => a.payment === 'unpaid' && a.status !== 'cancelled');
    $('#statToday').textContent = todayApps.length;
    $('#statTodayTotal').textContent = money(todayApps.reduce((s,a)=>s+Number(a.price||0),0));
    $('#statWeek').textContent = weekApps.length;
    $('#statUnpaid').textContent = money(unpaid.reduce((s,a)=>s+Number(a.price||0),0));
    $('#statUnpaidCount').textContent = `${unpaid.length} cleaning${unpaid.length===1?'':'s'}`;

    const list = $('#todayAppointments');
    if (!todayApps.length) list.innerHTML = '<div class="empty">No cleanings scheduled for today.</div>';
    else list.innerHTML = todayApps.map(a => appointmentRowHtml(a, true)).join('');

    const tomorrow = new Date(); tomorrow.setDate(tomorrow.getDate()+1); const tomorrowISO = isoFromDate(tomorrow);
    const tomorrowApps = state.appointments.filter(a=>a.date===tomorrowISO && a.status==='scheduled').sort((a,b)=>a.time.localeCompare(b.time));
    const rem = $('#tomorrowReminderList');
    if (!tomorrowApps.length) rem.innerHTML = '<div class="empty">No reminders due tomorrow.</div>';
    else rem.innerHTML = tomorrowApps.map(a => {
      const c = customerById(a.customerId); const status = c?.textConsent || 'not_asked';
      const label = status === 'opted_in' ? 'Ready' : status === 'opted_out' ? 'Do not text' : 'Needs opt-in';
      return `<div class="compact-item"><span><strong>${escapeHtml(customerName(c))}</strong><small>${formatTime(a.time)} · ${escapeHtml(label)}</small></span><span class="pill ${status}">${escapeHtml(consentLabel(status))}</span></div>`;
    }).join('');
    $('#quickNotes').value = state.quickNotes || '';
    renderTodayRoute();renderFuelSnapshot();
  }

  function renderTodayRoute(){
    const list=$('#todayRouteList'); if(!list)return; const apps=todayRouteAppointments();
    if(!apps.length){list.innerHTML='<div class="empty">No remaining stops today.</div>';return;}
    list.innerHTML=apps.map((a,i)=>{const c=customerById(a.customerId);return `<div class="compact-item"><span><strong>${i+1}. ${escapeHtml(customerName(c))}</strong><small>${formatTime(a.time)}${c?.driveMinutes?` · allow ${escapeHtml(String(c.driveMinutes))} min drive`:''}</small></span><button class="secondary small" data-navigate-customer="${c?.id||''}">Navigate</button></div>`;}).join('');
  }

  function appointmentRowHtml(a, includeQuickActions = false) {
    const c = customerById(a.customerId);
    const statusClass = a.status === 'completed' ? 'success' : a.status === 'cancelled' ? 'danger' : '';
    const actions = includeQuickActions ? `<button class="secondary small" data-text-customer="${a.customerId}">Text</button>` : '';
    return `<div class="appointment-row" data-edit-appointment="${a.id}">
      <div class="appointment-time">${formatTime(a.time)}</div>
      <div class="appointment-meta"><strong>${escapeHtml(customerName(c))}</strong><small>${escapeHtml(c?.city || '')}${c?.city ? ' · ' : ''}${money(a.price)} · ${escapeHtml(a.notes || frequencyLabel(c?.frequency))}${a.status==='completed'&&durationMinutes(a)?` · ${money(grossHourly(a))}/hr`:''}</small></div>
      <div class="row-actions">${actions}<span class="status ${statusClass}">${escapeHtml(a.status)}</span><span class="status ${a.payment==='paid'?'success':a.payment==='unpaid'?'warning':''}">${escapeHtml(a.payment.replace('_',' '))}</span><button class="secondary small" data-edit-appointment-btn="${a.id}">Open</button></div>
    </div>`;
  }

  function renderCustomers() {
    const q = ($('#customerSearch').value || '').trim().toLowerCase();
    const filter = $('#customerTextFilter').value;
    const customers = [...state.customers].sort((a,b)=>customerName(a).localeCompare(customerName(b))).filter(c => {
      const blob = [customerName(c),c.phone,c.city,c.notes,c.pets,c.address].join(' ').toLowerCase();
      return (!q || blob.includes(q)) && (filter === 'all' || (c.textConsent || 'not_asked') === filter);
    });
    const grid = $('#customerGrid');
    if (!customers.length) {
      grid.innerHTML = `<div class="empty" style="grid-column:1/-1">${state.customers.length ? 'No customers match that filter.' : 'No customers yet. Add your first customer to get started.'}</div>`;
      return;
    }
    grid.innerHTML = customers.map(c => {
      const next = getUpcomingAppointment(c.id);
      const consent = c.textConsent || 'not_asked';
      return `<article class="customer-card" data-edit-customer="${c.id}">
        <div class="customer-card-head"><div><h3>${escapeHtml(customerName(c))}</h3><p>${escapeHtml(frequencyLabel(c.frequency))} · ${money(c.price)}</p></div><span class="pill ${consent}">${escapeHtml(consentLabel(consent))}</span></div>
        <div class="customer-detail">
          <div>☎ ${escapeHtml(c.phone || 'No phone')}</div>
          <div>⌂ ${escapeHtml([c.city,c.state].filter(Boolean).join(', ') || 'No address')}</div>
          <div>▦ ${next ? `Next: ${formatDate(next.date,{short:true})} at ${formatTime(next.time)}` : 'No upcoming cleaning'}</div>
          ${customerMetrics(c.id).jobs?`<div>↗ Avg ${money(customerMetrics(c.id).grossHourly)}/hr · ${formatDuration(customerMetrics(c.id).minutes/customerMetrics(c.id).jobs)}</div>`:''}
          ${c.pets ? `<div>🐾 ${escapeHtml(c.pets)}</div>` : ''}
          ${c.notes ? `<div>📝 ${escapeHtml(c.notes)}</div>` : ''}
        </div>
      </article>`;
    }).join('');
  }

  function renderSchedule() {
    const y = calendarCursor.getFullYear(), m = calendarCursor.getMonth();
    $('#calendarTitle').textContent = new Intl.DateTimeFormat('en-US',{month:'long',year:'numeric'}).format(calendarCursor);
    $('#calendarSubtitle').textContent = `${state.appointments.filter(a=>{const d=parseDate(a.date);return d&&d.getFullYear()===y&&d.getMonth()===m&&a.status!=='cancelled'}).length} scheduled cleanings`;
    const first = new Date(y,m,1); const start = new Date(y,m,1-first.getDay());
    const today = todayISO();
    let html='';
    for (let i=0;i<42;i++) {
      const d = new Date(start); d.setDate(start.getDate()+i); const iso = isoFromDate(d);
      const apps = state.appointments.filter(a=>a.date===iso).sort((a,b)=>a.time.localeCompare(b.time));
      html += `<button class="calendar-day ${d.getMonth()!==m?'muted':''} ${iso===today?'today':''}" data-calendar-date="${iso}" type="button"><span class="day-number">${d.getDate()}</span>${apps.slice(0,3).map(a=>{const c=customerById(a.customerId);return `<div class="cal-event ${a.status==='cancelled'?'cancelled':''}" title="${escapeHtml(customerName(c))} ${formatTime(a.time)}">${escapeHtml(customerName(c))} ${formatTime(a.time)}</div>`}).join('')}${apps.length>3?`<div class="cal-event">+${apps.length-3} more</div>`:''}</button>`;
    }
    $('#calendarGrid').innerHTML=html;

    const upcoming = state.appointments.filter(a=>a.date>=today && a.status!=='cancelled').sort((a,b)=>`${a.date}T${a.time}`.localeCompare(`${b.date}T${b.time}`)).slice(0,20);
    $('#upcomingList').innerHTML = upcoming.length ? upcoming.map(a=>`<div class="appointment-row" data-edit-appointment="${a.id}"><div class="appointment-time">${formatDate(a.date,{short:true})}<br><small>${formatTime(a.time)}</small></div><div class="appointment-meta"><strong>${escapeHtml(customerName(customerById(a.customerId)))}</strong><small>${money(a.price)} · ${escapeHtml(a.notes||'Cleaning')}</small></div><div class="row-actions"><span class="status ${a.status==='completed'?'success':''}">${escapeHtml(a.status)}</span><button class="secondary small" data-edit-appointment-btn="${a.id}">Open</button></div></div>`).join('') : '<div class="empty">No upcoming appointments.</div>';
  }

  fun