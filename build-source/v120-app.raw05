function refreshDialogFieldsFromAppointment(a){if(!a)return;$('#appointmentStatus').value=a.status||'scheduled';$('#appointmentPayment').value=a.payment||'not_due';$('#appointmentMiles').value=a.miles||'';$('#appointmentExpenses').value=a.expenses||'';$('#appointmentFuelPrice').value=a.fuelPrice||state.fuelSnapshot?.price||'';populateAppointmentVehicles(a.vehicleId||state.settings.activeVehicleId||'');renderWorkMode(a);}
  function persistWorkAppointment(a,message='Updated.'){a.updatedAt=new Date().toISOString();saveState();refreshDialogFieldsFromAppointment(a);if(message)toast(message);}
  async function computeRouteMiles(origin,destination){const key=String(state.settings.googlePlacesApiKey||'').trim();if(!key||!origin||!destination)return 0;try{await loadGoogleMapsJs();const {Route}=await google.maps.importLibrary('routes');const {routes}=await Route.computeRoutes({origin:{lat:origin.lat,lng:origin.lng},destination:{lat:destination.lat,lng:destination.lng},travelMode:'DRIVING',routingPreference:'TRAFFIC_AWARE',fields:['distanceMeters','durationMillis']});return numberOrZero(routes?.[0]?.distanceMeters)/1609.344;}catch{return 0;}}
  async function beginTrip(a){if(!a)return;try{const pos=await getCurrentPosition();a.tripStartedAt=new Date().toISOString();a.tripStartLocation=pos;a.updatedAt=new Date().toISOString();saveState();return true;}catch{a.tripStartedAt=new Date().toISOString();saveState();return false;}}
  async function arriveAtJob(){const a=appointmentFromDialog();if(!a)return;a.arrivedAt=new Date().toISOString();let autoMiles=0;try{const pos=await getCurrentPosition();a.arrivalLocation=pos;if(a.tripStartLocation)autoMiles=await computeRouteMiles(a.tripStartLocation,pos);}catch{}if(autoMiles>0){a.routeMilesEstimate=autoMiles;if(numberOrZero(a.miles)<=0)a.miles=Number(autoMiles.toFixed(1));persistWorkAppointment(a,`Arrival recorded · route estimate ${autoMiles.toFixed(1)} miles.`);}else persistWorkAppointment(a,'Arrival time recorded.');}
  function startCleaning(){const a=appointmentFromDialog();if(!a)return;if(a.status==='completed'){toast('This cleaning is already completed.');return;}if(!a.startedAt)a.startedAt=new Date().toISOString();a.status='in_progress';persistWorkAppointment(a,'Cleaning timer started.');}
  function finishCleaning(){
    const a=appointmentFromDialog();if(!a)return;const c=customerById(a.customerId);if(a.status==='completed'){toast('This cleaning is already completed.');return;}
    const now=new Date();if(!a.startedAt){const guess=numberOrZero(c?.expectedMinutes)||Number(prompt('How many minutes did this cleaning take?','120'))||120;a.startedAt=new Date(now.getTime()-guess*60000).toISOString();}
    a.completedAt=now.toISOString();a.durationMinutes=Math.max(1,Math.round((Date.parse(a.completedAt)-Date.parse(a.startedAt))/60000));a.status='completed';a.miles=numberOrZero($('#appointmentMiles').value);a.expenses=numberOrZero($('#appointmentExpenses').value);a.vehicleId=$('#appointmentVehicle').value||state.settings.activeVehicleId||'';a.fuelPrice=numberOrZero($('#appointmentFuelPrice').value)||numberOrZero(state.fuelSnapshot?.price);a.payment=confirm(`Mark ${money(a.price)} as paid now?`)?'paid':'unpaid';ensureNextAppointment(a,c);persistWorkAppointment(a,`Cleaning finished · ${formatDuration(a.durationMinutes)} · ${money(grossHourly(a))}/hr gross.`);
  }
  function skipCleaning(){const a=appointmentFromDialog();if(!a)return;if(!confirm('Skip this visit but keep the recurring schedule going?'))return;const c=customerById(a.customerId);a.status='skipped';a.reminder='skipped';a.payment='not_due';a.skippedAt=new Date().toISOString();ensureNextAppointment(a,c);persistWorkAppointment(a,'Visit skipped. The next recurring cleaning stays scheduled.');}
  function navigateCurrentAppointment(){const a=appointmentFromDialog();if(a)navigateToCustomer(customerById(a.customerId));}
  function callCurrentCustomer(){const a=appointmentFromDialog();const c=a?customerById(a.customerId):null;const phone=normalizePhone(c?.phone);if(!phone){toast('No phone number saved.');return;}window.location.href=`tel:${phone}`;}
  async function onMyWayCurrent(){const a=appointmentFromDialog();const c=a?customerById(a.customerId):null;if(!a||!c)return;await beginTrip(a);a.onMyWayAt=new Date().toISOString();if(c.textConsent!=='opted_in'||!normalizePhone(c.phone)){saveState();toast('Trip started. No text opened because this customer is not opted in for texts.');return;}const message=renderTemplate('on_my_way',c,a);state.textLog.unshift({id:uid(),customerId:c.id,appointmentId:a.id,type:'on_my_way',message,sentAt:new Date().toISOString()});saveState();window.location.href=buildSmsHref(c.phone,message);}
  async function scheduleLeaveReminder(){
    const a=appointmentFromDialog();const c=a?customerById(a.customerId):null;if(!a||!c)return;const drive=numberOrZero(c.driveMinutes);if(!drive){toast('Set this customer’s typical drive time first.');return;}
    const d=parseDate(a.date);const [h,m]=a.time.split(':').map(Number);d.setHours(h,m||0,0,0);d.setMinutes(d.getMinutes()-drive);if(d.getTime()<=Date.now()){toast('That leave time has already passed.');return;}
    try{const plugin=window.Capacitor?.Plugins?.LocalNotifications;if(!plugin)throw new Error('Notifications unavailable');const perm=await plugin.requestPermissions();if(perm?.display==='denied')throw new Error('Notification permission denied');await plugin.schedule({notifications:[{id:numericNotificationId(a.id),title:'Time to leave for your cleaning',body:`${customerName(c)} at ${formatTime(a.time)} · about ${drive} min drive`,schedule:{at:d},extra:{appointmentId:a.id}}]});a.leaveReminderAt=d.toISOString();saveState();toast(`Leave reminder set for ${new Intl.DateTimeFormat('en-US',{hour:'numeric',minute:'2-digit'}).format(d)}.`);}catch(e){toast('Phone notification could not be scheduled. You can still export the appointment to your phone calendar.');}
  }

  function addChecklistToggle(e){const box=e.target.closest('[data-check-index]');if(!box)return;const a=appointmentFromDialog();if(!a)return;a.checklistDone={...(a.checklistDone||{}),[box.dataset.checkIndex]:box.checked};a.updatedAt=new Date().toISOString();saveState();}
  async function saveAttachmentFile(file,kind){const a=appointmentFromDialog();if(!a||!file)return;let label=kind==='photo'?(prompt('Label this photo: Before, After, or other?','Before')||'Photo'):'Voice note';const id=uid();const rec={id,appointmentId:a.id,kind,label,name:file.name||label,mime:file.type||'',blob:file,createdAt:new Date().toISOString()};try{await putAttachment(rec);a.attachmentsMeta=[...(a.attachmentsMeta||[]),{id,kind,label,name:rec.name,mime:rec.mime,createdAt:rec.createdAt,deviceLocal:true}];saveState();renderAttachments(a);toast(`${kind==='photo'?'Photo':'Voice note'} saved on this device.`);}catch(e){toast('Could not save that attachment on this device.');}}
  async function renderAttachments(a){const el=$('#appointmentAttachments');if(!el)return;if(!a){el.innerHTML='';return;}const notes=(a.fieldNotes||[]).map(n=>`<div class="attachment-item"><span>📝 ${escapeHtml(n.text)}</span><small>${new Date(n.createdAt).toLocaleString()}</small></div>`);const metas=a.attachmentsMeta||[];const rows=[];for(const meta of metas){let local=false;try{local=!!(await getAttachment(meta.id));}catch{}rows.push(`<div class="attachment-item"><span>${meta.kind==='photo'?'📷':'🎤'} ${escapeHtml(meta.label||meta.name)}</span>${local?`<button type="button" class="secondary small" data-open-attachment="${meta.id}">Open</button>`:'<small>File stored on another device</small>'}</div>`);}el.innerHTML=[...rows,...notes].join('')||'<div class="field-help">No photos, voice notes, or field notes yet.</div>';}
  async function openAttachment(id){try{const rec=await getAttachment(id);if(!rec?.blob){toast('That file is not stored on this device.');return;}const url=URL.createObjectURL(rec.blob);window.open(url,'_blank');setTimeout(()=>URL.revokeObjectURL(url),60000);}catch{toast('Could not open attachment.');}}
  function addWrittenNote(){const a=appointmentFromDialog();if(!a)return;const text=prompt('Add a note for this cleaning:');if(!text?.trim())return;a.fieldNotes=[...(a.fieldNotes||[]),{id:uid(),text:text.trim(),createdAt:new Date().toISOString()}];persistWorkAppointment(a,'Note added.');}

  function deleteAppointment() {
    const id=$('#appointmentId').value; if(!id)return; if(!confirm('Delete this appointment?'))return;
    state.appointments=state.appointments.filter(a=>a.id!==id); $('#appointmentDialog').close(); saveState(); toast('Appointment deleted.');
  }

  function openComposeForCustomer(id) {
    showView('texts'); if(customerById(id)) $('#composeCustomer').value=id; $('#composeTemplate').value='day_before'; updateCompose();
    setTimeout(()=>$('#composeMessage').focus(),0);
  }

  function markTextSent() {
    const c=customerById($('#composeCustomer').value); if(!c||c.textConsent!=='opted_in'){toast('Texting is blocked for this customer.');return;}
    const appt=getUpcomingAppointment(c.id); state.textLog.unshift({id:uid(),customerId:c.id,appointmentId:appt?.id||null,type:$('#composeTemplate').value,message:$('#composeMessage').value,sentAt:new Date().toISOString()});
    if(appt && $('#composeTemplate').value==='day_before') appt.reminder='sent'; saveState(); toast('Text marked as sent.');
  }

  function saveSettings() {
    state.settings.businessName=$('#businessName').value.trim()||'Clear Choice Cleaning'; state.settings.ownerName=$('#ownerName').value.trim(); state.settings.ownerPhone=$('#ownerPhone').value.trim(); state.settings.defaultPaymentNote=$('#defaultPaymentNote').value.trim(); state.settings.calendarReminderMinutes=Number($('#calendarReminderMinutes').value)||120; state.settings.mileageRate=Math.max(0,numberOrZero($('#mileageRate').value))||0.76;state.settings.googlePlacesApiKey=$('#googlePlacesApiKey').value.trim();state.settings.fuelSearchRadiusMiles=Math.max(1,Math.min(30,numberOrZero($('#fuelSearchRadiusMiles').value)||10));state.settings.preferredFuelType=$('#preferredFuelType').value;state.settings.activeVehicleId=$('#activeVehicle').value||state.settings.activeVehicleId||'';state.settings.taxEstimateEnabled=$('#taxEstimateEnabled').checked;state.settings.taxFilingStatus=$('#taxFilingStatus').value;state.settings.otherFederalIncome=Math.max(0,numberOrZero($('#otherFederalIncome').value));state.settings.otherWisconsinTaxableIncome=Math.max(0,numberOrZero($('#otherWisconsinTaxableIncome').value));state.settings.otherSocialSecurityWages=Math.max(0,numberOrZero($('#otherSocialSecurityWages').value));state.settings.taxReservePaid=Math.max(0,numberOrZero($('#taxReservePaid').value));
    state.settings.templates.day_before=$('#templateDayBefore').value.trim(); state.settings.templates.on_my_way=$('#templateOnMyWay').value.trim(); state.settings.templates.complete=$('#templateComplete').value.trim(); saveState(); toast('Settings saved.');
  }

  function exportBackup() {
    const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}); const url=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=url; a.download=`clear-choice-backup-${todayISO()}.json`; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url); toast('Backup exported.');
  }

  function importBackup(file) {
    const reader=new FileReader(); reader.onload=()=>{try{const parsed=JSON.parse(reader.result); if(!parsed||!Array.isArray(parsed.customers)||!Array.isArray(parsed.appointments))throw new Error('Invalid backup'); state={...defaultState(),...parsed}; saveState(); toast('Backup imported.');}catch(e){toast('That file is not a valid Clear Choice backup.');}}; reader.readAsText(file);
  }

  function resetApp() { if(!confirm('Reset the app and delete all local customers, appointments and settings? Export a backup first if you may need them.'))return; state=defaultState(); localStorage.removeItem(STORAGE_KEY); saveState({cloud:false}); t