oast('App reset.'); }

  function cloudConfigured() { return /^https:\/\/.+\.supabase\.co\/?$/.test(CONFIG.supabaseUrl||'') && !!CONFIG.supabaseAnonKey; }
  function loadAuth(){try{return JSON.parse(localStorage.getItem(AUTH_KEY)||'null')}catch{return null}}
  function saveAuth(auth){if(auth)localStorage.setItem(AUTH_KEY,JSON.stringify(auth));else localStorage.removeItem(AUTH_KEY);renderCloudStatus();renderAll();}
  function parseJwt(token){try{let part=token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/');while(part.length%4)part+='=';return JSON.parse(atob(part))}catch{return {}}}

  async function authRequest(path, body) {
    const res=await fetch(`${CONFIG.supabaseUrl.replace(/\/$/,'')}/auth/v1/${path}`,{method:'POST',headers:{'apikey':CONFIG.supabaseAnonKey,'Content-Type':'application/json'},body:JSON.stringify(body)});
    const data=await res.json().catch(()=>({})); if(!res.ok)throw new Error(data.msg||data.message||data.error_description||'Cloud request failed'); return data;
  }

  async function cloudSignUp() {
    if(!cloudConfigured()){toast('Add your Supabase URL and anon key to config.js first.');return;}
    const email=$('#cloudEmail').value.trim(),password=$('#cloudPassword').value; if(!email||password.length<6){toast('Enter an email and a password of at least 6 characters.');return;}
    try{const data=await authRequest('signup',{email,password}); if(data.access_token){saveAuth(data);await pushCloud();toast('Cloud account created and synced.');}else toast('Account created. Check your email if Supabase asks you to confirm it, then sign in.');}catch(e){toast(e.message)}
  }

  async function cloudSignIn() {
    if(!cloudConfigured()){toast('Add your Supabase URL and anon key to config.js first.');return;}
    const email=$('#cloudEmail').value.trim(),password=$('#cloudPassword').value; if(!email||!password){toast('Enter your cloud email and password.');return;}
    try{const data=await authRequest('token?grant_type=password',{email,password});saveAuth(data);await syncCloud();toast('Signed in and synced.');}catch(e){toast(e.message)}
  }

  async function refreshAuth() {
    const auth=loadAuth(); if(!auth?.refresh_token) return null;
    try{const data=await authRequest('token?grant_type=refresh_token',{refresh_token:auth.refresh_token});saveAuth(data);return data}catch{saveAuth(null);return null}
  }

  async function apiFetch(path, opts={}) {
    let auth=loadAuth(); if(!auth?.access_token)throw new Error('Sign in to cloud sync first.');
    const run=async(token)=>fetch(`${CONFIG.supabaseUrl.replace(/\/$/,'')}/rest/v1/${path}`,{...opts,headers:{'apikey':CONFIG.supabaseAnonKey,'Authorization':`Bearer ${token}`,'Content-Type':'application/json',...(opts.headers||{})}});
    let res=await run(auth.access_token); if(res.status===401){auth=await refreshAuth();if(!auth)throw new Error('Cloud session expired. Please sign in again.');res=await run(auth.access_token);} if(!res.ok){const t=await res.text();throw new Error(t||'Cloud sync failed');}return res;
  }

  async function pushCloud() {
    if(!cloudConfigured()||!loadAuth()?.access_token)return;
    const auth=loadAuth(),payload=parseJwt(auth.access_token); const userId=payload.sub; if(!userId)throw new Error('Could not identify cloud account.');
    await apiFetch('app_state?on_conflict=user_id',{method:'POST',headers:{Prefer:'resolution=merge-duplicates,return=minimal'},body:JSON.stringify({user_id:userId,data:state,updated_at:state.updatedAt})});
    renderCloudStatus();
  }

  async function pullCloud() {
    const res=await apiFetch('app_state?select=data,updated_at&limit=1',{method:'GET'}); const rows=await res.json(); return rows?.[0]||null;
  }

  async function syncCloud() {
    if(!cloudConfigured()){toast('Cloud sync is not configured yet.');return;}
    if(!loadAuth()?.access_token){toast('Sign in to cloud sync first.');return;}
    try{
      const remote=await pullCloud();
      if(!remote){await pushCloud();return;}
      const localTime=Date.parse(state.updatedAt||0),remoteTime=Date.parse(remote.data?.updatedAt||remote.updated_at||0);
      if(remoteTime>localTime){state={...defaultState(),...remote.data};localStorage.setItem(STORAGE_KEY,JSON.stringify(state));renderAll();}
      else await pushCloud();
      renderCloudStatus();
    }catch(e){toast(`Sync problem: ${e.message}`)}
  }

  function scheduleCloudPush(){clearTimeout(cloudPushTimer); if(cloudConfigured()&&loadAuth()?.access_token) cloudPushTimer=setTimeout(()=>pushCloud().catch(e=>console.warn(e)),1600)}
  function cloudSignOut(){saveAuth(null);toast('Cloud sync signed out. Local data is still on this device.');}
  function renderCloudStatus(){const el=$('#cloudStatus');if(!el)return;if(!cloudConfigured()){el.textContent='Cloud sync is optional and currently not configured. The app is fully usable on this device. Follow README.md to add your free Supabase project.';return;}const auth=loadAuth();el.textContent=auth?.access_token?'Signed in. Changes are saved locally first and then synced to Supabase while the app is open.':'Supabase is configured. Sign in here on each device to sync the same records.';}

  async function copyPreparedText() {
    const c=customerById($('#composeCustomer').value);
    if(!c||c.textConsent!=='opted_in'){toast('Texting is blocked for this customer.');return;}
    const text=$('#composeMessage').value;
    try {
      if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(text);
      else { const ta=document.createElement('textarea');ta.value=text;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove(); }
      toast('Message copied. Paste it into Google Messages or your phone texting app.');
    } catch { toast('Could not copy automatically. Select the message and copy it manually.'); }
  }

  function exportCalendar() {
    const upcoming=state.appointments.filter(a=>a.status!=='cancelled'&&a.date>=todayISO()).sort((a,b)=>`${a.date}T${a.time}`.localeCompare(`${b.date}T${b.time}`));
    if(!upcoming.length){toast('No upcoming appointments to export.');return;}
    const esc=s=>String(s||'').replace(/\\/g,'\\\\').replace(/;/g,'\\;').replace(/,/g,'\\,').replace(/\n/g,'\\n');
    const pad=n=>String(n).padStart(2,'0');
    const dt=(date,time)=>{const d=parseDate(date);const [h,m]=time.split(':').map(Number);return `${d.getFullYear()}${pad(d.getMonth()+1)}${pad(d.getDate())}T${pad(h)}${pad(m)}00`;};
    const reminderMinutes=Number(state.settings.calendarReminderMinutes)||120;
    const lines=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Clear Choice Cleaning//Cleaning Manager//EN','CALSCALE:GREGORIAN'];
    for(const a of upcoming){const c=customerById(a.customerId);const start=dt(a.date,a.time);const endD=new Date(parseDate(a.date));const [h,m]=a.time.split(':').map(Number);endD.setHours(h+2,m||0,0,0);const end=`${endD.getFullYear()}${pad(endD.getMonth()+1)}${pad(endD.getDate())}T${pad(endD.getHours())}${pad(endD.getMinutes())}00`;lines.push('BEGIN:VEVENT',`UID:${a.id}@clearchoice`, `DTSTART:${start}`,`DTEND:${end}`,`SUMMARY:${esc(`Cleaning - ${customerName(c)}`)}`,`LOCATION:${esc([c?.address,c?.city,c?.state,c?.zip].filter(Boolean).join(', '))}`,`DESCRIPTION:${esc([a.notes,c?.notes,c?.access].filter(Boolean).join(' | '))}`,'BEGIN:VALARM',`TRIGGER:-PT${reminderMinutes}M`,'ACTION:DISPLAY','DESCRIPTION:Cleaning appointment reminder','END:VALARM','END:VEVENT');}
    lines.push('END:VCALENDAR');
    const blob=new Blob([lines.join('\r\n')],{type:'text/calendar;charset=utf-8'});const url=URL.createObjectURL(blob);const link=document.createElement('a');link.href=url;link.download=`clear-choice-schedule-${todayISO()}.ics`;document.body.appendChild(link);link.click();link.remove();URL.revokeObjectURL(url);toast(`Calendar exported with a ${reminderMinutes >= 1440 ? `${reminderMinutes/1440}-day` : `${reminderMinutes/60}-hour`} reminder for each cleaning.`);
  }

  function bindEvents() {
    $$('.nav-item').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.view))); $$('[data-go]').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.go)));
    $('#menuBtn').addEventListener('click',openDrawer); $('#drawerScrim').addEventListener('click',closeDrawer); $('#mobileAddBtn').addEventListener('click',()=>openAppointmentDialog());
    $('#addCustomerBtn').addEventListener('click',()=>openCustomerDialog()); $('#addCustomerDashboard').addEventListener('click',()=>openCustomerDialog()); $('#addAppointmentBtn').addEventListener('click',()=>openAppointmentDialog()); $('#addAppointmentDashboard').addEventListener('click',()=>openAppointmentDialog());
    $('#customerForm').addEventListener('submit',saveCustomerFromForm); $('#deleteCustomerBtn').addEventListener('click',deleteCustomer); $('#appointmentForm').addEventListener('submit',saveAppointmentFromForm); $('#deleteAppointmentBtn').addEventListener('click',deleteAppointment);
    $('#appointmentCustomer').addEventListener('change',()=>{const c=customerById($('#appointmentCustomer').value); if(c)$('#appointmentPrice').value=c.price||'';});
    $('#customerSearch').addEventListener('input',renderCustomers); $('#customerTextFilter').addEventListener('change',renderCustomers);
    $('#quickNotes').addEventListener('input',e=>{state.quickNotes=e.target.value;state.updatedAt=new Date().toISOString();localStorage.setItem(STORAGE_KEY,JSON.stringify(state));scheduleCloudPush();});
    $('#prevMonth').addEventListener('click',()=>{calendarCursor.setMonth(calendarCursor.getMonth()-1);renderSchedule()}); $('#nextMonth').addEventListener('click',()=>{calendarCursor.setMonth(calendarCursor.getMonth()+1);renderSchedule()}); $('#exportCalendarBtn').addEventListener('click',exportCalendar);
    $('#composeCustomer').addEventListener('change',updateCompose); $('#composeTemplate').addEventListener('change',updateCompose); $('#composeMessage').addEventListener('input',refreshComposeEligibility); $('#markTextSent').addEventListener('click',markTextSent);
    $('#openSmsLink').addEventListener('click',e=>{const c=customerById($('#composeCustomer').value);if(!c||c.textConsent!=='opted_in'||!normalizePhone(c.phone)){e.preventDefault();toast('Texting is blocked until the customer is opted in with a phone number.');}}); $('#copyTextBtn').addEventListener('click',copyPreparedText);
    $('#editTemplatesBtn').addEventListener('click',()=>{$('#modalTemplateDayBefore').value=state.settings.templates.day_before;$('#modalTemplateOnMyWay').value=state.settings.templates.on_my_way;$('#modalTemplateComplete').value=state.settings.templates.complete;$('#templateDialog').showModal()});
    $('#templateForm').addEventListener('submit',e=>{e.preventDefault();state.settings.templates.day_before=$('#modalTemplateDayBefore').value.trim();state.settings.templates.on_my_way=$('#modalTemplateOnMyWay').value.trim();state.settings.templates.complete=$('#modalTemplateComplete').value.trim();$('#templateDialog').close();saveState();toast('Templates saved.');});
    $('#saveSettingsBtn').addEventListener('click',saveSettings); $('#exportData').addEventListener('click',exportBackup); $('#importData').addEventListener('change',e=>{if(e.target.files?.[0])importBackup(e.target.files[0]);e.target.value=''}); $('#resetData').addEventListener('click',resetApp);
    $('#cloudSignUp').addEventListener('click',cloudSignUp); $('#cloudSignIn').addEventListener('click',cloudSignIn); $('#cloudSyncNow').addEventListener('click',syncCloud); $('#cloudSignOut').addEventListener('click',cloudSignOut);
    document.addEventListener('click',e=>{
      const card=e.target.closest('[data-edit-customer]'); if(card){openCustomerDialog(card.dataset.editCustomer);return;}
      const appt=e.target.closest('[data-edit-appointment-btn]'); if(appt){e.stopPropagation();openAppointmentDialog(appt.dataset.editAppointmentBtn);return;}
      const row=e.target.closest('[data-edit-appointment]'); if(row && !e.target.closest('button')){openAppoi