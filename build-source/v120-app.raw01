ddress)}`:`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`);
  }
  function todayRouteAppointments(){return state.appointments.filter(a=>a.date===todayISO()&&!['cancelled','skipped','completed'].includes(a.status)).sort((a,b)=>a.time.localeCompare(b.time));}
  function openTodayRoute(){
    const apps=todayRouteAppointments().filter(a=>fullAddress(customerById(a.customerId))); if(!apps.length){toast('No remaining addresses on today’s route.');return;}
    if(apps.length===1){navigateToCustomer(customerById(apps[0].customerId));return;}
    const addresses=apps.map(a=>fullAddress(customerById(a.customerId))); const dest=addresses.pop();
    openExternal(`https://www.google.com/maps/dir/?api=1&travelmode=driving&destination=${encodeURIComponent(dest)}&waypoints=${encodeURIComponent(addresses.join('|'))}`);
  }

  function menuItems(data){const raw=data?.menuItem??data?.menuItems?.menuItem??data?.menuItems??[];return Array.isArray(raw)?raw:raw?[raw]:[];}
  async function fuelEconomyFetch(path){
    const res=await fetch(`https://www.fueleconomy.gov/ws/rest/${path}`,{headers:{Accept:'application/json'}});if(!res.ok)throw new Error('FuelEconomy.gov lookup failed');return res.json();
  }
  async function loadVehicleYears(){const sel=$('#vehicleYear');if(!sel)return;sel.innerHTML='<option>Loading…</option>';try{const data=await fuelEconomyFetch('vehicle/menu/year');const items=menuItems(data);sel.innerHTML='<option value="">Select year</option>'+items.map(x=>`<option value="${escapeHtml(x.value)}">${escapeHtml(x.text)}</option>`).join('');}catch{sel.innerHTML='<option value="">Could not load years</option>';}}
  async function loadVehicleMakes(){const year=$('#vehicleYear')?.value,sel=$('#vehicleMake');if(!sel)return;$('#vehicleModel').innerHTML='<option value="">Select model</option>';$('#vehicleOption').innerHTML='<option value="">Select trim / drivetrain</option>';if(!year){sel.innerHTML='<option value="">Select make</option>';return;}sel.innerHTML='<option>Loading…</option>';try{const data=await fuelEconomyFetch(`vehicle/menu/make?year=${encodeURIComponent(year)}`);sel.innerHTML='<option value="">Select make</option>'+menuItems(data).map(x=>`<option value="${escapeHtml(x.value)}">${escapeHtml(x.text)}</option>`).join('');}catch{sel.innerHTML='<option value="">Could not load makes</option>';}}
  async function loadVehicleModels(){const year=$('#vehicleYear')?.value,make=$('#vehicleMake')?.value,sel=$('#vehicleModel');if(!sel)return;$('#vehicleOption').innerHTML='<option value="">Select trim / drivetrain</option>';if(!year||!make){sel.innerHTML='<option value="">Select model</option>';return;}sel.innerHTML='<option>Loading…</option>';try{const data=await fuelEconomyFetch(`vehicle/menu/model?year=${encodeURIComponent(year)}&make=${encodeURIComponent(make)}`);sel.innerHTML='<option value="">Select model</option>'+menuItems(data).map(x=>`<option value="${escapeHtml(x.value)}">${escapeHtml(x.text)}</option>`).join('');}catch{sel.innerHTML='<option value="">Could not load models</option>';}}
  async function loadVehicleOptions(){const year=$('#vehicleYear')?.value,make=$('#vehicleMake')?.value,model=$('#vehicleModel')?.value,sel=$('#vehicleOption');if(!sel)return;if(!year||!make||!model){sel.innerHTML='<option value="">Select trim / drivetrain</option>';return;}sel.innerHTML='<option>Loading…</option>';try{const data=await fuelEconomyFetch(`vehicle/menu/options?year=${encodeURIComponent(year)}&make=${encodeURIComponent(make)}&model=${encodeURIComponent(model)}`);sel.innerHTML='<option value="">Select trim / drivetrain</option>'+menuItems(data).map(x=>`<option value="${escapeHtml(x.value)}">${escapeHtml(x.text)}</option>`).join('');}catch{sel.innerHTML='<option value="">Could not load options</option>';}}
  async function addSelectedVehicle(){
    const id=$('#vehicleOption')?.value;if(!id){toast('Choose the exact trim / drivetrain first.');return;}
    try{const d=await fuelEconomyFetch(`vehicle/${encodeURIComponent(id)}`);const option=$('#vehicleOption').selectedOptions[0]?.textContent||'';const v={id:uid(),epaId:String(id),year:String(d.year||$('#vehicleYear').value),make:d.make||$('#vehicleMake').value,model:d.model||$('#vehicleModel').value,option,mpgCity:numberOrZero(d.city08),mpgHighway:numberOrZero(d.highway08),mpgCombined:numberOrZero(d.comb08),fuelType:d.fuelType||d.fuelType1||'',createdAt:new Date().toISOString()};state.settings.vehicles=[...(state.settings.vehicles||[]).filter(x=>x.epaId!==v.epaId),v];state.settings.activeVehicleId=v.id;const ft=String(v.fuelType||'').toLowerCase();if(ft.includes('diesel'))state.settings.preferredFuelType='DIESEL';else if(ft.includes('premium'))state.settings.preferredFuelType='PREMIUM';else if(ft.includes('e85'))state.settings.preferredFuelType='E85';else state.settings.preferredFuelType='REGULAR_UNLEADED';saveState();toast(`${v.year} ${v.make} ${v.model} added · ${v.mpgCombined||'—'} MPG combined.`);}catch(e){toast(e.message||'Could not load that vehicle.');}
  }
  function renderVehicleSettings(){
    const sel=$('#activeVehicle');if(!sel)return;const vehicles=state.settings.vehicles||[];sel.innerHTML=vehicles.length?vehicles.map(v=>`<option value="${v.id}">${escapeHtml(`${v.year} ${v.make} ${v.model} · ${v.mpgCombined||'—'} MPG`)}</option>`).join(''):'<option value="">No vehicle saved</option>';if(state.settings.activeVehicleId)sel.value=state.settings.activeVehicleId;
    const v=activeVehicle();$('#activeVehicleSummary').innerHTML=v?`<strong>${escapeHtml(`${v.year} ${v.make} ${v.model}`)}</strong><span>${escapeHtml(v.option||'')} · ${v.mpgCity||'—'} city / ${v.mpgHighway||'—'} highway / ${v.mpgCombined||'—'} combined MPG · ${escapeHtml(v.fuelType||'fuel')}</span>`:'<span>Search your vehicle below and the app will pull its EPA MPG automatically.</span>';
    $('#preferredFuelType').value=state.settings.preferredFuelType||'REGULAR_UNLEADED';$('#googlePlacesApiKey').value=state.settings.googlePlacesApiKey||'';$('#fuelSearchRadiusMiles').value=String(state.settings.fuelSearchRadiusMiles||10);renderFuelSnapshot();
  }
  async function fetchReferenceFuelPrice(silent=false){
    try{const d=await fuelEconomyFetch('fuelprices');const type=state.settings.preferredFuelType||'REGULAR_UNLEADED';const map={REGULAR_UNLEADED:'regular',MIDGRADE:'midgrade',PREMIUM:'premium',DIESEL:'diesel',E85:'e85'};const key=map[type]||'regular';const price=numberOrZero(d[key]);if(!price)throw new Error('No reference fuel price found');state.fuelSnapshot={price,average:price,source:'FuelEconomy.gov reference',stationName:'Reference price',stationAddress:'U.S. reference price',updatedAt:new Date().toISOString(),stations:[]};saveState();if(!silent)toast(`Fuel reference updated: ${money(price)}/gal.`);return state.fuelSnapshot;}catch(e){if(!silent)toast(e.message||'Could not update fuel price.');return null;}
  }
  async function getCurrentPosition(){const plugin=window.Capacitor?.Plugins?.Geolocation;if(plugin){const perm=await plugin.requestPermissions();if(perm?.location==='denied'&&perm?.coarseLocation==='denied')throw new Error('Location permission denied');const p=await plugin.getCurrentPosition({enableHighAccuracy:true,timeout:15000,maximumAge:300000});return {lat:p.coords.latitude,lng:p.coords.longitude};}return new Promise((resolve,reject)=>navigator.geolocation?navigator.geolocation.getCurrentPosition(p=>resolve({lat:p.coords.latitude,lng:p.coords.longitude}),reject,{enableHighAccuracy:true,timeout:15000,maximumAge:300000}):reject(new Error('Location unavailable')));}
  let googleMapsLoadPromise=null;
  function loadGoogleMapsJs(){const key=String(state.settings.googlePlacesApiKey||'').trim();if(!key)return Promise.reject(new Error('Google Places API key not configured'));if(window.google?.maps?.importLibrary)return Promise.resolve(window.google);if(googleMapsLoadPromise)return googleMapsLoadPromise;googleMapsLoadPromise=new Promise((resolve,reject)=>{const script=document.createElement('script');script.src=`https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(key)}&v=weekly&libraries=places`;script.async=true;script.onload=()=>window.google?.maps?.importLibrary?resolve(window.google):reject(new Error('Google Maps did not initialize'));script.onerror=()=>reject(new Error('Google Maps could not load'));document.head.appendChild(script);});return googleMapsLoadPromise;}
  function fuelMoneyToNumber(m){return numberOrZero(m?.units)+(numberOrZero(m?.nanos)/1e9);}
  async function fetchNearbyFuelPrices({silent=false}={}){
    const key=String(state.settings.googlePlacesApiKey||'').trim();if(!key){if(!silent)toast('Add a Google Maps/Places API key for exact nearby station prices. Using the automatic U.S. reference price for now.');return fetchReferenceFuelPrice(silent);}
    if(!isAndroidNative()&&!silent){toast('Exact nearby fuel lookup is intended for the Android app.');return null;}
    try{const pos=await getCurrentPosition();await loadGoogleMapsJs();const {Place,SearchNearbyRankPreference}=await google.maps.importLibrary('places');const radius=Math.max(1,Math.min(30,numberOrZero(state.settings.fuelSearchRadiusMiles)||10))*1609.344;const {places}=await Place.searchNearby({fields:['displayName','formattedAddress','location','fuelOptions'],locationRestriction:{center:{lat:pos.lat,lng:pos.lng},radius},includedTypes:['gas_station'],maxResultCount:12,rankPreference:SearchNearbyRankPreference.DISTANCE});const wanted=state.settings.preferredFuelType||'REGULAR_UNLEADED';const stations=(places||[]).map(pl=>{const fp=(pl.fuelOptions?.fuelPrices||[]).find(x=>String(x.type)===wanted)||(pl.fuelOptions?.fuelPrices||[])[0];const price=fuelMoneyToNumber(fp?.price);const lat=typeof pl.location?.lat==='function'?pl.location.lat():pl.location?.lat;const lng=typeof pl.location?.lng==='function'?pl.location.lng():pl.location?.lng;return {name:pl.displayName||'Gas station',address:pl.formattedAddress||'',lat,lng,price,type:String(fp?.type||''),updatedAt:fp?.updateTime?.toISOString?.()||String(fp?.updateTime||'')};}).filter(x=>x.price>0);if(!stations.length)throw new Error('Nearby stations were found, but no current fuel prices were available.');const avg=stations.reduce((sum,x)=>sum+x.price,0)/stations.length;const best=[...stations].sort((a,b)=>a.price-b.price)[0];state.fuelSnapshot={price:avg,average:avg,bestPrice:best.price,source:'Google Places nearby',stationName:best.name,stationAddress:best.address,updatedAt:new Date().toISOString(),stations};saveState();if(!silent)toast(`Nearby fuel updated · avg ${money(avg)}/gal · best ${money(best.price)}/gal.`);return state.fuelSnapshot;}catch(e){if(!silent)toast(`${e.message} Using the reference price instead.`);return fetchReferenceFuelPrice(silent);}
  }
  function renderFuelSnapshot(){
    const snap=state.fuelSnapshot;const box=$('#fuelSnapshot');if(box)box.innerHTML=snap?`<strong>${money(snap.price)}/gal</strong><span>${escapeHtml(snap.source)} · ${new Date(snap.updatedAt).toLocaleString()}</span>${snap.bestPrice?`<small>Best nearby: ${money(snap.bestPrice)} · ${escapeHtml(snap.stationName||'')}</small>`:''}`:'<span>No fuel price loaded yet.</span>';
    const dash=$('#dashboardFuelPrice');if(dash){dash.textContent=snap?`${money(snap.price)}/gal`:'—';$('#dashboardFuelSource').textContent=snap?`${snap.source}${snap.bestPrice?` · best ${money(snap.bestPrice)}`:''}`:'Tap refresh to load current fuel pricing.';}
    const list=$('#nearbyFuelList');if(list){const stations=snap?.stations||[];list.innerHTML=stations.length?stations.slice(0,6).map((x,i)=>`<div class="compact-item"><span><strong>${escapeHtml(x.name)}</strong><small>${escapeHtml(x.address)}</small></span><div class="row-actions"><span class="status success">${money(x.price)}/gal</span>${isAndroidNative()?`<button class="secondary small" data-fuel-station="${i}">Go</button>`:''}</div></div>`).join(''):'<div class="empty">Exact nearby station prices appear here after Android location lookup.</div>'