<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".BillNestApp"
        android:allowBackup="true"
        android:label="BillNest"
        android:theme="@style/Theme.BillNest"
        android:usesCleartextTraffic="true">
        <activity android:name=".HouseholdActivity" android:exported="false" />
        <activity android:name=".V2MainActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".AuthActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
