         "body_bob": sin(_idle_time * 1.7) * 0.018,
+        "axe_pitch": 0.0,
+        "grip_inward": 0.0,
         "axe_visible": false,
     }
+
+func _chop_pose(phase: float) -> Dictionary:
+    var shoulder := -0.25
+    var elbow := 0.24
+    var torso_pitch := 0.0
+    var torso_yaw := 0.0
+    var axe_pitch := 0.08
+    var grip_inward := 0.08
+    var body_bob := 0.0
+
+    if phase < 0.24:
+        var t := _smooth01(phase / 0.24)
+        shoulder = lerpf(-0.25, -1.72, t)
+        elbow = lerpf(0.24, 1.08, t)
+        torso_pitch = lerpf(0.0, -0.09, t)
+        torso_yaw = lerpf(0.0, -0.20, t)
+        axe_pitch = lerpf(0.08, -0.30, t)
+        grip_inward = lerpf(0.08, 0.26, t)
+        body_bob = lerpf(0.0, 0.035, t)
+    elif phase < CHOP_IMPACT_PHASE:
+        var t := _ease_in_quad((phase - 0.24) / (CHOP_IMPACT_PHASE - 0.24))
+        shoulder = lerpf(-1.72, 0.54, t)
+        elbow = lerpf(1.08, 0.18, t)
+        torso_pitch = lerpf(-0.09, 0.24, t)
+        torso_yaw = lerpf(-0.20, 0.13, t)
+        axe_pitch = lerpf(-0.30, 0.16, t)
+        grip_inward = lerpf(0.26, 0.13, t)
+        body_bob = lerpf(0.035, -0.055, t)
+    elif phase < 0.70:
+        var t := _smooth01((phase - CHOP_IMPACT_PHASE) / (0.70 - CHOP_IMPACT_PHASE))
+        shoulder = lerpf(0.54, 0.76, t)
+        elbow = lerpf(0.18, 0.38, t)
+        torso_pitch = lerpf(0.24, 0.29, t)
+        torso_yaw = lerpf(0.13, 0.20, t)
+        axe_pitch = lerpf(0.16, 0.24, t)
+        grip_inward = lerpf(0.13, 0.10, t)
+        body_bob = lerpf(-0.055, -0.03, t)
+    else:
+        var t := _smooth01((phase - 0.70) / 0.30)
+        shoulder = lerpf(0.76, -0.25, t)
+        elbow = lerpf(0.38, 0.24, t)
+        torso_pitch = lerpf(0.29, 0.0, t)
+        torso_yaw = lerpf(0.20, 0.0, t)
+        axe_pitch = lerpf(0.24, 0.08, t)
+        grip_inward = lerpf(0.10, 0.08, t)
+        body_bob = lerpf(-0.03, 0.0, t)
+
+    return {
+        "action": "chopping",
+        "left_leg": -0.08 - maxf(0.0, torso_pitch) * 0.22,
+        "right_leg": 0.11 + maxf(0.0, torso_pitch) * 0.18,
+        "left_arm": shoulder * 0.96,
+        "right_arm": shoulder,
+        "left_elbow": elbow * 0.90,
+        "right_elbow": elbow,
+        "torso_pitch": torso_pitch,
+        "torso_yaw": torso_yaw,
+        "body_bob": body_bob,
+        "axe_pitch": axe_pitch,
+        "grip_inward": grip_inward,
+        "axe_visible": true,
+    }
+
+func _smooth01(value: float) -> float:
+    var t := clampf(value, 0.0, 1.0)
+    return t * t * (3.0 - 2.0 * t)
+
+func _ease_in_quad(value: float) -> float:
+    var t := clampf(value, 0.0, 1.0)
+    return t * t
