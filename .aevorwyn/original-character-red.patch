diff -ruN '--exclude=Aevorwyn-v6-source.tgz' aevorwyn-v7-baseline/tests/test_character_assembler.gd aevorwyn-original-character/srcpkg/tests/test_character_assembler.gd
--- aevorwyn-v7-baseline/tests/test_character_assembler.gd	1970-01-01 00:00:00.000000000 +0000
+++ aevorwyn-original-character/srcpkg/tests/test_character_assembler.gd	2026-09-13 20:49:33.513384972 +0000
@@ -0,0 +1,16 @@
+extends RefCounted
+
+func run() -> Array[String]:
+    var failures: Array[String] = []
+    if not ClassDB.class_exists("CharacterAssembler"):
+        failures.append("CharacterAssembler class must exist")
+        return failures
+    var assembler := CharacterAssembler.new()
+    assembler.apply_appearance(CharacterAppearance.default())
+    for node_name in ["BodyRoot", "Head", "EyeL", "EyeR", "Nose", "Mouth", "EarL", "EarR", "Hair", "TorsoClothing", "LegClothing", "Feet", "ToolSocketR"]:
+        if assembler.find_child(node_name, true, false) == null:
+            failures.append("assembled character missing %s" % node_name)
+    if assembler.vendor_asset_paths().size() != 0:
+        failures.append("original character must not load vendor assets")
+    assembler.free()
+    return failures
