diff -ruN '--exclude=Aevorwyn-v6-source.tgz' aevorwyn-v7-baseline/tests/test_aevorwyn_character_animator.gd aevorwyn-original-character/srcpkg/tests/test_aevorwyn_character_animator.gd
--- aevorwyn-v7-baseline/tests/test_aevorwyn_character_animator.gd	1970-01-01 00:00:00.000000000 +0000
+++ aevorwyn-original-character/srcpkg/tests/test_aevorwyn_character_animator.gd	2026-09-13 20:49:33.515346471 +0000
@@ -0,0 +1,18 @@
+extends RefCounted
+
+func run() -> Array[String]:
+    var failures: Array[String] = []
+    if not ClassDB.class_exists("AevorwynCharacterAnimator"):
+        failures.append("AevorwynCharacterAnimator class must exist")
+        return failures
+    var animator := AevorwynCharacterAnimator.new()
+    if animator.forward_axis() != Vector3(0, 0, -1):
+        failures.append("character forward axis must be -Z")
+    var yaw := animator.facing_yaw(Vector3.ZERO, Vector3(1, 0, 0))
+    if absf(yaw + PI * 0.5) > 0.01:
+        failures.append("facing helper must rotate toward target")
+    var phases: Array = animator.chop_phases()
+    if phases != [&"ready", &"backswing", &"strike", &"impact", &"recover"]:
+        failures.append("woodcutting phases must be ready/backswing/strike/impact/recover")
+    animator.free()
+    return failures
