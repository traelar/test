@@ -59,6 +64,31 @@
         })
     return events
 
+func advance(delta: float) -> Array[Dictionary]:
+    var events: Array[Dictionary] = []
+    if _touches.size() != 1:
+        return events
+    var keys := _touches.keys()
+    if keys.is_empty():
+        return events
+    var index: int = int(keys[0])
+    if bool(_consumed.get(index, false)) or bool(_dragged.get(index, false)) or bool(_long_press_fired.get(index, false)):
+        return events
+    var next_time := float(_held_time.get(index, 0.0)) + maxf(0.0, delta)
+    _held_time[index] = next_time
+    if next_time >= LONG_PRESS_SECONDS:
+        _long_press_fired[index] = true
+        _consumed[index] = true
+        events.append({
+            "type": "long_press",
+            "position": Vector2(_starts.get(index, _touches[index])),
+        })
+    return events
+
+func consume_active_touches() -> void:
+    for key in _touches.keys():
+        _consumed[key] = true
+
 func touch_released(index: int, position: Vector2) -> Dictionary:
     if not _touches.has(index):
         return {"type": "none"}
@@ -71,6 +101,8 @@
     _starts.erase(index)
     _dragged.erase(index)
     _consumed.erase(index)
+    _held_time.erase(index)
+    _long_press_fired.erase(index)
 
     if _touches.size() < 2:
         _pinch_distance = 0.0
