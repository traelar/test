
+    if _touches.size() >= 2:
+        for key in _touches.keys():
+            _consumed[key] = true
+        _pinch_distance = _first_two_distance()
+
+func touch_dragged(index: int, position: Vector2, relative: Vector2) -> Array[Dictionary]:
+    var events: Array[Dictionary] = []
+    if not _touches.has(index):
+        return events
+
+    _touches[index] = position
+
+    if _touches.size() >= 2:
+        for key in _touches.keys():
+            _consumed[key] = true
+        var current_distance := _first_two_distance()
+        if _pinch_distance > 0.0:
+            var distance_delta := current_distance - _pinch_distance
+            if absf(distance_delta) > 0.01:
+                events.append({
+                    "type": "zoom",
+                    "amount": -distance_delta * PINCH_ZOOM_SENSITIVITY,
+                })
+        _pinch_distance = current_distance
+        return events
+
+    var start: Vector2 = _starts.get(index, position)
+    if bool(_dragged.get(index, false)) or position.distance_to(start) >= drag_threshold:
+        _dragged[index] = true
+        _consumed[index] = true
+        events.append({
+            "type": "orbit",
+            "delta": relative,
+        })
+    return events
+
+func touch_released(index: int, position: Vector2) -> Dictionary:
+    if not _touches.has(index):
+        return {"type": "none"}
+
+    var was_dragged := bool(_dragged.get(index, false))
+    var was_consumed := bool(_consumed.get(index, false))
+    var start: Vector2 = _starts.get(index, position)
+
+    _touches.erase(index)
+    _starts.erase(index)
+    _dragged.erase(index)
+    _consumed.erase(index)
+
+    if _touches.size() < 2:
+        _pinch_distance = 0.0
+
+    if was_dragged or was_consumed or position.distance_to(start) >= drag_threshold:
+        return {"type": "none"}
+
+    return {
+        "type": "tap",
+        "position": position,
+    }
+
+func _first_two_distance() -> float:
+    var keys := _touches.keys()
+    if keys.size() < 2:
+        return 0.0
+    var a: Vector2 = _touches[keys[0]]
+    var b: Vector2 = _touches[keys[1]]
+    return a.distance_to(b)
