+func show_context_menu(screen_position: Vector2, entries: Array) -> void:
+    _ensure_context_menu()
+    for child in _context_column.get_children():
+        child.queue_free()
+    _context_entries = 0
+
+    var header := Label.new()
+    header.text = "Choose option"
+    header.add_theme_font_size_override("font_size", 13)
+    header.add_theme_color_override("font_color", Color(0.72, 0.80, 0.80))
+    _context_column.add_child(header)
+
+    for entry_value in entries:
+        if not entry_value is Dictionary:
+            continue
+        var entry: Dictionary = entry_value
+        var action_id := String(entry.get("id", ""))
+        var label_text := String(entry.get("label", action_id))
+        var button := Button.new()
+        button.text = label_text
+        button.alignment = HORIZONTAL_ALIGNMENT_LEFT
+        button.custom_minimum_size = Vector2(196, 44)
+        button.add_theme_font_size_override("font_size", 14)
+        button.pressed.connect(_on_context_action_pressed.bind(action_id))
+        _context_column.add_child(button)
+        _context_entries += 1
+
+    var viewport_size := get_viewport().get_visible_rect().size if get_viewport() != null else Vector2(1280, 720)
+    var menu_size := Vector2(216, 54 + 44 * _context_entries)
+    _context_panel.position = Vector2(
+        clampf(screen_position.x + 8.0, 8.0, maxf(8.0, viewport_size.x - menu_size.x - 8.0)),
+        clampf(screen_position.y + 8.0, 8.0, maxf(8.0, viewport_size.y - menu_size.y - 8.0))
+    )
+    _context_panel.visible = true
+    if _menu_panel != null:
+        _menu_panel.visible = false
+
+func hide_context_menu() -> void:
+    if _context_panel != null:
+        _context_panel.visible = false
+
+func is_context_menu_open() -> bool:
+    return _context_panel != null and _context_panel.visible
+
+func context_menu_entry_count() -> int:
+    return _context_entries
+
+func _ensure_context_menu() -> void:
+    if _context_panel != null:
+        return
+    _context_panel = PanelContainer.new()
+    _context_panel.name = "ContextActionMenu"
+    _context_panel.z_index = 50
+    _context_panel.custom_minimum_size = Vector2(216, 0)
+    _context_panel.add_theme_stylebox_override("panel", _panel_style(Color(0.018, 0.026, 0.032, 0.97), Color(0.30, 0.46, 0.49, 0.98), 10))
+    _context_panel.visible = false
+    add_child(_context_panel)
+
+    var margin := MarginContainer.new()
+    margin.add_theme_constant_override("margin_left", 9)
+    margin.add_theme_constant_override("margin_right", 9)
+    margin.add_theme_constant_override("margin_top", 8)
+    margin.add_theme_constant_override("margin_bottom", 8)
+    _context_panel.add_child(margin)
+
+    _context_column = VBoxContainer.new()
+    _context_column.add_theme_constant_override("separation", 4)
+    margin.add_child(_context_column)
+
+func _on_context_action_pressed(action_id: String) -> void:
+    hide_context_menu()
+    context_action_selected.emit(action_id)
+
 func _panel_style(background: Color, border: Color, radius: int) -> StyleBoxFlat:
     var style := StyleBoxFlat.new()
     style.bg_color = background
