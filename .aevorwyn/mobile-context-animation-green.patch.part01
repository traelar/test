     if hit.is_empty():
         return
 
@@ -146,6 +177,64 @@
     _current_enemy = null
     _player.request_move(hit.get("position", _player.global_position))
 
+func _raycast_pointer(screen_position: Vector2) -> Dictionary:
+    var camera := _camera_rig.get_camera()
+    if camera == null:
+        return {}
+    var ray_from := camera.project_ray_origin(screen_position)
+    var ray_to := ray_from + camera.project_ray_normal(screen_position) * 250.0
+    var query := PhysicsRayQueryParameters3D.create(ray_from, ray_to)
+    query.exclude = [_player.get_rid()]
+    return get_world_3d().direct_space_state.intersect_ray(query)
+
+func _open_context_menu_at(screen_position: Vector2) -> void:
+    var hit := _raycast_pointer(screen_position)
+    if hit.is_empty():
+        return
+    _context_screen_position = screen_position
+    _context_hit_position = hit.get("position", _player.global_position)
+    _context_target = hit.get("collider") as Object
+
+    var entries: Array = []
+    if _context_target is ResourceNode:
+        var resource := _context_target as ResourceNode
+        if resource.can_interact():
+            var definition := resource.interaction_definition()
+            entries.append({"id": "primary", "label": "Chop %s" % String(definition.get("name", "Tree"))})
+    elif _context_target is Enemy:
+        var enemy := _context_target as Enemy
+        if enemy.can_interact():
+            entries.append({"id": "primary", "label": "Attack %s" % String(enemy.enemy_state.get("name", "Enemy"))})
+
+    entries.append({"id": "walk", "label": "Walk here"})
+    if _context_target is ResourceNode or _context_target is Enemy:
+        entries.append({"id": "examine", "label": "Examine"})
+    entries.append({"id": "cancel", "label": "Cancel"})
+    _hud.show_context_menu(screen_position, entries)
+
+func _on_context_action_selected(action_id: String) -> void:
+    match action_id:
+        "primary":
+            _handle_pointer_click(_context_screen_position)
+        "walk":
+            _cancel_gathering()
+            _current_enemy = null
+            _player.request_move(_context_hit_position)
+        "examine":
+            if _context_target is ResourceNode:
+                var resource := _context_target as ResourceNode
+                var definition := resource.interaction_definition()
+                _session.message.emit("A %s. It can be chopped for resources." % String(definition.get("name", "tree")))
+            elif _context_target is Enemy:
+                var enemy := _context_target as Enemy
+                _session.message.emit("%s · %d/%d health" % [
+                    String(enemy.enemy_state.get("name", "Enemy")),
+                    int(enemy.enemy_state.get("health", 0)),
+                    int(enemy.enemy_state.get("max_health", 1))
+                ])
+        "cancel":
+            pass
+
 func _process_pending_resource() -> void:
     if _pending_resource == null or not is_instance_valid(_pending_resource):
         _cancel_gathering()
