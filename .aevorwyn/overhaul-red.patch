diff --git a/tests/test_skills_tab.gd b/tests/test_skills_tab.gd
new file mode 100644
index 0000000..fb3c17b
--- /dev/null
+++ b/tests/test_skills_tab.gd
@@ -0,0 +1,35 @@
+extends RefCounted
+
+func run() -> Array[String]:
+    var failures: Array[String] = []
+    var script = load("res://src/ui/skills_tab.gd")
+    if script == null:
+        failures.append("skills tab should exist")
+        return failures
+    var tab = script.new()
+    if not tab.has_method("set_skills") or not tab.has_method("total_level") or not tab.has_method("skill_detail"):
+        failures.append("skills tab must expose skills, total level, and detail APIs")
+        tab.free()
+        return failures
+
+    var skills: Dictionary = {}
+    for skill_id in GameSession.SKILL_IDS:
+        skills[skill_id] = {"level": 1, "xp": 0}
+    tab.set_skills(skills)
+    if tab.skill_count() != 14:
+        failures.append("skills tab must show all 14 approved skills")
+    if tab.total_level() != 14:
+        failures.append("fourteen level-one skills should total level 14")
+
+    var detail: Dictionary = tab.skill_detail(&"woodcutting")
+    if StringName(detail.get("skill_id", "")) != &"woodcutting":
+        failures.append("skill detail must identify Woodcutting")
+    if int(detail.get("next_level_xp", 0)) != SkillService.new().xp_for_level(2):
+        failures.append("skill detail must use the canonical XP curve for next level")
+    if int(detail.get("xp_to_next", -1)) != SkillService.new().xp_for_level(2):
+        failures.append("skill detail must show XP remaining to level 2")
+    var progress := float(detail.get("progress", -1.0))
+    if progress < 0.0 or progress > 1.0:
+        failures.append("skill detail progress must be normalized")
+    tab.free()
+    return failures
