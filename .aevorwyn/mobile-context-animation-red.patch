     if first_pinch_release.get("type", "") == "tap" or second_pinch_release.get("type", "") == "tap":
         failures.append("a pinch gesture must not trigger a world tap when fingers release")
 
+    gestures.reset()
+    gestures.touch_pressed(0, Vector2(160, 140))
+    if not gestures.has_method("advance"):
+        failures.append("mobile gestures must expose timed long-press detection")
+    else:
+        var before_hold: Array = gestures.call("advance", 0.30)
+        if not before_hold.is_empty():
+            failures.append("a normal short touch must not open the context menu early")
+        var hold_events: Array = gestures.call("advance", 0.20)
+        if hold_events.is_empty() or hold_events[0].get("type", "") != "long_press":
+            failures.append("holding one finger should emit a long_press event")
+        else:
+            if Vector2(hold_events[0].get("position", Vector2.ZERO)).distance_to(Vector2(160, 140)) > 1.0:
+                failures.append("long_press should use the original touch position")
+        var held_release := gestures.touch_released(0, Vector2(161, 140))
+        if held_release.get("type", "") == "tap":
+            failures.append("releasing after a long press must not also trigger walking")
+
+    gestures.reset()
+    gestures.touch_pressed(0, Vector2(220, 180))
+    if not gestures.has_method("consume_active_touches"):
+        failures.append("magnify gestures need a way to consume active touches so zoom never walks")
+    else:
+        gestures.call("consume_active_touches")
+        var magnify_release := gestures.touch_released(0, Vector2(221, 181))
+        if magnify_release.get("type", "") == "tap":
+            failures.append("a touch involved in magnify/zoom must never resolve as a world tap")
+
     return failures
