+++ b/src/player/aevorwyn_equipment_visuals.gd	2026-09-13 21:57:08.758520866 +0000
@@ -0,0 +1,48 @@
+class_name AevorwynEquipmentVisuals
+extends RefCounted
+
+const SLOTS: Array[StringName] = [
+    &"head", &"chest", &"hands", &"legs", &"feet", &"cape", &"main_hand", &"off_hand",
+]
+
+const FULL_HAIR_HIDE_HEAD_ITEMS: Array[StringName] = [
+    &"greenwake_guard_helm",
+]
+
+static func slots() -> Array[StringName]:
+    return SLOTS.duplicate()
+
+static func supports_slot(slot: StringName) -> bool:
+    return SLOTS.has(slot)
+
+static func hides_hair(item_id: StringName) -> bool:
+    return FULL_HAIR_HIDE_HEAD_ITEMS.has(item_id)
+
+static func palette(item_id: StringName) -> Dictionary:
+    if String(item_id).begins_with("greenwake_guard_"):
+        return {
+            "primary": Color("526b61"),
+            "secondary": Color("34483f"),
+            "trim": Color("b5bcae"),
+            "leather": Color("60452f"),
+        }
+    if item_id == &"greenwake_scout_cape":
+        return {
+            "primary": Color("315b4c"),
+            "secondary": Color("1f3e35"),
+            "trim": Color("a99562"),
+            "leather": Color("60452f"),
+        }
+    if item_id == &"greenwake_round_shield":
+        return {
+            "primary": Color("5c4933"),
+            "secondary": Color("3a3028"),
+            "trim": Color("9ba9a4"),
+            "leather": Color("60452f"),
+        }
+    return {
+        "primary": Color("68736f"),
+        "secondary": Color("454e4b"),
+        "trim": Color("aeb9b5"),
+        "leather": Color("60452f"),
+    }
